{
  "schemaVersion": 1,
  "id": "david.heimdall",
  "name": "Heimdall",
  "version": "1.1.0",
  "author": "David",
  "description": "Heimdall continuity: an attention icon that opens a needs/agents/workstreams panel.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Heimdall.qml"
  },
  "barWidget": {
    "displayName": "Heimdall",
    "description": "Attention icon + dropdown panel from the Heimdall daemon; highlights when work needs you.",
    "category": "System",
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 5,
      "notifyOnNeeds": true,
      "snapshotWarnMin": 10,
      "unsavedWarnDays": 5
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "notifyOnNeeds",
        "type": "boolean",
        "label": "Notify when something needs you",
        "defaultValue": true
      },
      {
        "key": "snapshotWarnMin",
        "type": "integer",
        "label": "Warn when snapshot older than (minutes)",
        "min": 1,
        "max": 1440,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "unsavedWarnDays",
        "type": "integer",
        "label": "Unsaved warning after (days)",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
