{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heimdall workspace snapshot request v1",
  "description": "CLI-only saved envelopes. Runtime additionally validates byte/control bounds, source and binding identity, current revisions/heads, max-dirty >= debounce, pin limits, retained payload availability and protected references. Observations are daemon-derived, never supplied in a request.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "op",
        "target",
        "previous",
        "expected_task_revision",
        "manifest_id",
        "source_id",
        "input_digest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "op": {
          "const": "capture"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,22}[a-z0-9]$"
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "const": "none"
            }
          ]
        },
        "expected_task_revision": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "op",
        "target",
        "previous",
        "expected_task_revision",
        "manifest_id",
        "source_id",
        "policy"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "op": {
          "const": "policy"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,22}[a-z0-9]$"
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "const": "none"
            }
          ]
        },
        "expected_task_revision": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "debounce_seconds",
            "max_dirty_seconds",
            "retain_count"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "debounce_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "max_dirty_seconds": {
              "type": "integer",
              "minimum": 5,
              "maximum": 300
            },
            "retain_count": {
              "type": "integer",
              "minimum": 2,
              "maximum": 256
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "op",
        "target",
        "previous",
        "snapshot_id",
        "reason"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "op": {
          "const": "pin"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,22}[a-z0-9]$"
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "const": "none"
            }
          ]
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "op",
        "target",
        "previous",
        "snapshot_id",
        "reason"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "op": {
          "const": "unpin"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,22}[a-z0-9]$"
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "const": "none"
            }
          ]
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "op",
        "target",
        "previous",
        "snapshot_ids",
        "reason"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "op": {
          "const": "prune"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,22}[a-z0-9]$"
        },
        "previous": {
          "const": "none"
        },
        "snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  ]
}
