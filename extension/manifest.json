{
  "manifest_version": 3,
  "name": "Heimdall Browser Bridge",
  "version": "0.2.0",
  "description": "Paired local browser metadata and managed-tab controls for Heimdall.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "storage",
    "alarms"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}