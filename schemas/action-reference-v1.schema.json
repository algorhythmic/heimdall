{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared browser action and attempt wire reference v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "id", "attempt_id", "intent_digest", "target", "manifest_id", "surface_id"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "attempt_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "intent_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,22}[a-z0-9]$", "not": {"enum": ["unassigned", "radiator"]}},
    "manifest_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "surface_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"}
  }
}
