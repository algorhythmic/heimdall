{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heimdall artifact checkpoint command v2",
  "description": "CLI-only artifact checkpoints. Runtime also requires sorted unique artifact IDs, exact current version heads, target/resource scope and fresh matching file identity. Legacy writer grants cannot use this version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "op",
    "target",
    "expected_task_revision",
    "checkpoint"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "op": {
      "const": "checkpoint.record"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "expected_task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "head": {
      "oneOf": [
        {
          "const": "none"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "lines": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 128,
      "items": {
        "type": "string",
        "pattern": "\\S",
        "maxLength": 4096
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous",
        "contract_id",
        "summary",
        "next_action",
        "artifacts"
      ],
      "properties": {
        "previous": {
          "$ref": "#/$defs/head"
        },
        "contract_id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "current_step": {
          "type": "string"
        },
        "next_action": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 8192
        },
        "blockers": {
          "$ref": "#/$defs/lines"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "version_id"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "#/$defs/id"
              },
              "version_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    }
  }
}
